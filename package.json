  "license": "AGPL-3.0-or-later",
  "author": "Nick Reynolds",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/check-line-limits.mjs && node --test",
    "serve": "node serve.mjs",
